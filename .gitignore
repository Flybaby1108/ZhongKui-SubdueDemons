# ──────────── Godot 4 standard ignores ────────────
# https://github.com/github/gitignore/blob/main/Godot.gitignore

# Godot 4+ specific ignores
.godot/
/android/

# Imported translations (automatically generated from CSV files)
*.translation

# System/tool-specific ignores
.directory
*~

# ──────────── Editor / OS noise ────────────
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# ──────────── Build artifacts ────────────
# The web export is regenerated by GitHub Actions on every push.
# We don't want to commit the binary build output (5MB+) — let CI rebuild it.
build/

# ──────────── Debug screenshots / playtest artifacts ────────────
# F1 tuning-panel screenshots and ad-hoc playtest captures.
# These were generated during development for debugging — not part of the game.
test_*.png
test_*.png.import
tuning_test_*.png
tuning_test_*.png.import

# Ad-hoc Godot SceneTree test scripts (run via `godot --script`),
# not part of the runtime game.
test_*.gd
test_*.gd.uid

# ──────────── OpenCode session/agent files (if any) ────────────
.opencode/
.opencode-session/
.playwright-mcp/
.sisyphus/
# AI assistant config — contains internal gateway URL, NOT for public repo
opencode.json

# ──────────── Development helper scripts (not part of the game runtime) ────────────
# These are one-off utilities used during level/asset authoring. Kept locally
# but not shipped to the public repo per project owner's call.
clean_old_entities.py
fix_grid_ratio.py
rewrite_editor.py
rewrite_editor_ui.py
scripts/gen_levels.py
scripts/gen_placeholders.py
# Standalone HTML level editor — tracked in repo for collaborative editing
# level_editor.html
